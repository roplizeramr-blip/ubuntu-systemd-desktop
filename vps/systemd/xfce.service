[Unit]
Description=XFCE desktop session on :1
After=kasmvnc.service
Requires=kasmvnc.service

[Service]
Type=simple
User=desktop
Group=desktop
PAMName=login
EnvironmentFile=-/etc/cloud-desktop/desktop.env
Environment=HOME=/home/desktop
Environment=DISPLAY=:1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=x11
Environment=XDG_CURRENT_DESKTOP=XFCE
Environment=XDG_SESSION_DESKTOP=xfce
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=WEBKIT_DISABLE_DMABUF_RENDERER=1
Environment=GTK_A11Y=none
Environment=NO_AT_BRIDGE=1
ExecStart=/usr/local/bin/start-xfce.sh
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=cloud-desktop.target
