# Copy to .env and edit.  Never commit .env.

# Required: KasmVNC Basic Auth password (min 6 characters).
VNC_PW=change-me-please
VNC_USER=admin
VNC_AUTH=1

# Desktop geometry and frame rate.
VNC_RESOLUTION=1440x900
VNC_FRAME_RATE=30

# Public port.  PUBLIC_DESKTOP=1 publishes the desktop at "/" and moves the
# status page to "/status".
CONTROL_PORT=3000
PUBLIC_DESKTOP=1

# Linux passwords.  Leave empty to keep the accounts locked.
DESKTOP_PW=
ROOT_PW=

# Desktop preferences.
TZ=Africa/Cairo
DESKTOP_ICONS=0
CHROME_AUTOSTART=1
CHROME_NO_SANDBOX=1

# Optional swap file.
SWAP_ENABLED=0
SWAP_SIZE_MB=6144
