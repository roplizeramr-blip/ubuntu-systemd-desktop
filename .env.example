# Copy to .env and edit.  Never commit .env.

# Required: HTTP Basic Auth password for the public port (min 6 characters).
VNC_PW=change-me-please
VNC_USER=admin
VNC_AUTH=1

# Desktop geometry.
VNC_RESOLUTION=1280x720

# Ports.  PORT is public (nginx); the others are loopback-only.
PORT=3000
CONTROL_PORT=3001
WS_PORT=6080
VNC_PORT=5901

# Public desktop.  PUBLIC_DESKTOP=1 opens noVNC at "/" and moves the status page
# to "/status"; 0 keeps the status page at "/" and the desktop at /vnc.html.
PUBLIC_DESKTOP=1

# Linux passwords.  Leave empty to keep the accounts locked.
DESKTOP_PW=
ROOT_PW=

# Desktop preferences.
TZ=Africa/Cairo
CHROME_AUTOSTART=1
CHROME_NO_SANDBOX=1

# Optional swap file.
SWAP_ENABLED=0
SWAP_SIZE_MB=6144
